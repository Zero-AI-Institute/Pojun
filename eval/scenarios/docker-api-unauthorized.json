  "stages": [
    "recon",
    "authz"
  ],
  "max_minutes": 30,
  "expected": [
    {
      "vulnclass": "未授权访问",
      "severity": "critical"
    },
    {
      "vulnclass": "权限提升",
      "optional": true
    }
  ],
  "require_goal": false
}
